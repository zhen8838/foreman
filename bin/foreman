#!/usr/bin/env python3
"""foreman — hand a plan, or a one-line job, to agents in their own worktree.

Two modes:
  solo  one agent takes it all the way to a PR.
  pair  two agents in one worktree: impl writes, review gates and stays read-only.

foreman does two things: start the agents, wire them to each other. Watching a screen and
taking one over are not wrapped (`herdr agent read/attach` directly). Only messaging is, as
`foreman say` — channel rules have to be enforced by the program, not by good intentions.

Usage: `foreman --help`. Config and templates: see the repo README.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

VERSION = "0.1.0"

REPO = Path(__file__).resolve().parent.parent
LOCAL = REPO / "local"
JOBS = REPO / "state" / "jobs"

ROLE_SUFFIX = {"impl": "-impl", "review": "-rev"}
MODE_ROLES = {"solo": ["solo"], "pair": ["impl", "review"]}


# ── helpers ───────────────────────────────────────────────────────────────────


class Fail(SystemExit):
    def __init__(self, msg: str) -> None:
        super().__init__(f"foreman: {msg}")


def run(argv: list[str], *, cwd: Path | None = None, check: bool = True,
        env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        argv, cwd=cwd, check=check, text=True, capture_output=True,
        env={**os.environ, **env} if env else None,
    )


def herdr(*argv: str) -> dict:
    """Run one herdr command and return the `result` object out of its JSON."""
    proc = run(["herdr", *argv], check=False)
    if proc.returncode != 0:
        raise Fail(f"herdr {' '.join(argv)} failed: {proc.stderr.strip() or proc.stdout.strip()}")
    out = proc.stdout.strip()
    if not out:
        return {}
    try:
        return json.loads(out).get("result", {})
    except json.JSONDecodeError:
        return {"_raw": out}


def git(path: Path, *argv: str) -> str:
    proc = run(["git", "-C", str(path), *argv], check=False)
    return proc.stdout.strip() if proc.returncode == 0 else ""


def load_toml(path: Path) -> dict:
    with path.open("rb") as fh:
        return tomllib.load(fh)


def resolve(rel: str) -> Path:
    """`local/x` wins over the repo's `x`; an absolute path is used as given."""
    p = Path(rel).expanduser()
    if p.is_absolute():
        return p
    override = LOCAL / rel
    return override if override.exists() else REPO / rel


# ── config ────────────────────────────────────────────────────────────────────


def load_settings() -> dict:
    path = LOCAL / "foreman.toml"
    if not path.exists():
        raise Fail(f"missing {path} — run ./install.sh once; it seeds one from examples/")
    return load_toml(path)


def project_files() -> list[Path]:
    return sorted(p for p in LOCAL.glob("*.toml") if p.name != "foreman.toml")


def load_project(name: str | None, settings: dict) -> dict:
    """Pick the project: explicit --project → cwd's git toplevel matching `main` → default."""
    candidates = {}
    for path in project_files():
        cfg = load_toml(path)
        # the one free-text block is per role now; a leftover rules/notes would say nothing
        # to anybody, silently, so refuse instead of dropping it
        if stale := [k for k in ("rules", "notes") if k in cfg]:
            raise Fail(f"{path}: {', '.join(stale)} no longer reaches any template — split it "
                       f"into solo_notes / impl_notes / review_notes, one per role")
        cfg.setdefault("name", path.stem)
        cfg["_path"] = str(path)
        candidates[cfg["name"]] = cfg
    if not candidates:
        raise Fail(f"no project config in {LOCAL} — write one after examples/project.toml")

    if name:
        if name not in candidates:
            raise Fail(f"no project {name} (known: {', '.join(sorted(candidates))})")
        return candidates[name]

    top = run(["git", "rev-parse", "--show-toplevel"], check=False).stdout.strip()
    if top:
        top = str(Path(top).resolve())
        for cfg in candidates.values():
            if str(Path(cfg["main"]).expanduser().resolve()) == top:
                return cfg

    default = settings.get("default_project")
    if default and default in candidates:
        return candidates[default]
    raise Fail("can't tell which project — pass --project, run inside the project's main "
               "worktree, or set default_project")


def agent_spec(settings: dict, mode: str, role: str, args: argparse.Namespace) -> dict:
    """Mode defaults plus command-line overrides → the agent this role runs on."""
    key = "agent" if mode == "solo" else role
    spec = dict(settings.get("modes", {}).get(mode, {}).get(key, {}))
    if not spec.get("kind"):
        raise Fail(f"local/foreman.toml: [modes.{mode}.{key}] has no kind")

    def override(field: str) -> str | None:
        # a targeted override like --review-kind beats the blanket --kind
        targeted = getattr(args, f"review_{field}", None) if role == "review" else None
        return targeted or getattr(args, field, None)

    default_kind = spec["kind"]
    for field in ("kind", "model", "effort", "tier"):
        if value := override(field):
            spec[field] = value
    if spec["kind"] != default_kind:
        # the defaults belong to the old kind (a codex model name means nothing to claude),
        # so keep only what was asked for explicitly and let the new agent read its own config
        for field in ("model", "effort", "tier"):
            if not override(field):
                spec.pop(field, None)
    return spec


def submit_prompt(target: str, text: str, *, tries: int = 3, settle_s: float = 1.5) -> None:
    """Submit a prompt, then confirm a new turn actually started.

    For codex `herdr agent prompt` is fill-and-enter, done in one step. Claude Code is not:
    a long body collapses into a `[Pasted text #N]` chip, the paste swallows the enter, and
    the text sits in the input box with the agent having read nothing. In a pair that fails
    silently — review never starts, the gate is entirely on review, and the result is an
    ungated solo while `foreman status` looks fine.

    What counts as proof is a **transition**, not a state. `working` on its own can be the
    turn the agent was already running, and herdr lumps idle, done and blocked together as
    not-busy (that is what `agent wait` matches without --until), so `!= idle` reads a
    just-finished `done` as success. Since `say` waits with `agent wait`, it delivers exactly
    when the recipient enters `done` — the reading that gets misjudged is the one it will
    almost always see. `state_change_seq` only moves when the status really changes, so a
    fresh `working` is one whose seq differs from the one taken before the prompt.

    An agent already working when the prompt arrives is a case nothing here can settle:
    Claude Code queues the message and its status never changes, so delivery neither proves
    nor disproves itself. Send the enter regardless — on an empty box it does nothing — and
    say plainly that this was not confirmed rather than claim it landed.
    """
    before = herdr("agent", "get", target).get("agent", {})
    seq = before.get("state_change_seq")
    herdr("agent", "prompt", target, text)
    for _ in range(tries):
        time.sleep(settle_s)
        info = herdr("agent", "get", target).get("agent", {})
        if info.get("agent_status") == "working" and info.get("state_change_seq") != seq:
            return
        herdr("agent", "send-keys", target, "enter")
    if before.get("agent_status") == "working":
        sys.stderr.write(
            f"foreman: {target} was already working, so delivery could not be confirmed — "
            f"the message is most likely queued.\n        Check with: herdr agent read "
            f"{target}\n")
    else:
        sys.stderr.write(
            f"foreman: {target} never started a new turn — the text may be stuck in the "
            f"input box.\n        Go look: herdr agent attach {target}\n")


def agent_argv(settings: dict, spec: dict) -> list[str]:
    """Turn model/effort/tier into flags via the kinds table. Unset means absent, which
    leaves the agent reading its own config."""
    kind = spec["kind"]
    table = settings.get("kinds", {}).get(kind)
    if table is None:
        raise Fail(f"local/foreman.toml has no [kinds.{kind}]")
    argv = list(table.get("args", []))
    for field, flag_key in (("model", "model_flag"), ("effort", "effort_flag"),
                            ("tier", "tier_flag")):
        value = spec.get(field)
        if not value:
            continue
        for tok in table.get(flag_key, []):
            argv.append(tok.replace("{" + field + "}", str(value)))
    return argv


# ── templates ─────────────────────────────────────────────────────────────────


def find_template(project: dict, name: str) -> Path:
    """Find a template, most specific first:

      local/templates/<project>/<name>.md   this project only
      local/templates/<name>.md             this machine
      templates/<name>.md                   shipped default

    An explicit path under [templates] in the project toml wins outright. Changing a prompt
    means dropping a file into one of those layers — no code involved.
    """
    explicit = project.get("templates", {}).get(name)
    if explicit:
        path = resolve(explicit)
        if not path.exists():
            raise Fail(f"[templates].{name} points at {path}, which does not exist")
        return path
    for cand in (
        LOCAL / "templates" / project["name"] / f"{name}.md",
        LOCAL / "templates" / f"{name}.md",
        REPO / "templates" / f"{name}.md",
    ):
        if cand.exists():
            return cand
    raise Fail(f"no template {name}.md anywhere")


def template_path(project: dict, role: str, mode: str) -> Path:
    name = "solo" if mode == "solo" else f"pair-{'impl' if role == 'impl' else 'review'}"
    return find_template(project, name)


def render(path: Path, fields: dict[str, str], protocol: str = "") -> str:
    """Fill a template. `{protocol}` goes in verbatim first, then every field.

    The order matters: impl and review share one protocol fragment, and that fragment carries
    placeholders of its own such as `{peer_pane}`. Splicing it in first is what lets those
    get filled too.
    """
    text = path.read_text()
    if protocol:
        text = text.replace("{protocol}", protocol)
    for key, value in fields.items():
        # toml multi-line strings carry stray newlines; strip so templates gain no blanks
        text = text.replace("{" + key + "}", (value or "").strip())
    # drop a heading whose body the project left empty, rather than leave it dangling
    text = re.sub(r"^##[^\n]*\n\s*(?=^##|\Z)", "", text, flags=re.M)
    text = re.sub(r"\n{3,}", "\n\n", text)
    left = set(re.findall(r"\{([a-z_]+)\}", text)) - set(fields)
    if left:
        raise Fail(f"{path} has unknown placeholders: {', '.join(sorted(left))}")
    return text.strip()


# ── job ledger ────────────────────────────────────────────────────────────────


def job_path(task: str) -> Path:
    return JOBS / f"{task}.json"


def read_job(task: str) -> dict:
    path = job_path(task)
    if not path.exists():
        known = sorted(p.stem for p in JOBS.glob("*.json"))
        raise Fail(f"no job {task} (known: {', '.join(known) or 'none'})")
    return json.loads(path.read_text())


def write_job(job: dict) -> None:
    JOBS.mkdir(parents=True, exist_ok=True)
    job_path(job["task"]).write_text(json.dumps(job, indent=2, ensure_ascii=False) + "\n")


def split_handle(ref: str) -> tuple[str, str | None]:
    """`t13.rev` / `t13-rev` / `t13` → (task, role|None)."""
    for sep in (".", "-"):
        head, _, tail = ref.rpartition(sep)
        if head and tail in ("impl", "rev", "review", "solo"):
            return head, {"rev": "review"}.get(tail, tail)
    return ref, None


def whoami() -> tuple[dict, str] | None:
    """Who am I: ask herdr which pane this is, then look it up in the ledger. None when
    there is no match — a human's own pane, for instance.

    **Deliberately not $HERDR_PANE_ID**: that is a snapshot inherited when the shell started,
    and it goes stale once a workspace is closed and reopened. At best it names a pane that
    no longer exists; at worst it collides with a recycled pane id in a new workspace and the
    message lands on someone else's job. `herdr pane current` validates and errors on a stale
    pane, which is exactly what we want.
    """
    try:
        pane = herdr("pane", "current").get("pane", {}).get("pane_id")
    except Fail:
        return None
    if not pane:
        return None
    for path in JOBS.glob("*.json"):
        job = json.loads(path.read_text())
        for role, info in job["agents"].items():
            if info["pane"] == pane:
                return job, role
    return None


def pick_role(job: dict, role: str | None) -> str:
    roles = list(job["agents"])
    if role is None:
        return "impl" if "impl" in roles else roles[0]
    if role not in roles:
        raise Fail(f"job {job['task']} has no role {role} (it has: {', '.join(roles)})")
    return role


# ── assign ────────────────────────────────────────────────────────────────────


def derive_task(args: argparse.Namespace) -> str:
    if args.task:
        return args.task
    if args.plan:
        stem = Path(args.plan).stem
        return re.sub(r"^\d+[-_]", "", stem)  # drop the plan's ordering prefix
    raise Fail("--prompt needs --task: there is no plan filename to derive it from")


def start_agent(handle: str, pane: str, spec: dict, settings: dict, plan: Plan) -> None:
    argv = ["agent", "start", handle, "--kind", spec["kind"], "--pane", pane,
            "--timeout", "60000"]
    extra = agent_argv(settings, spec)
    if extra:
        argv += ["--", *extra]
    plan.step(f"start {handle} ({spec['kind']}"
              f"{'/' + spec['effort'] if spec.get('effort') else ''})", ["herdr", *argv])
    if plan.dry:
        return
    herdr(*argv)
    # codex may ask to trust a directory the first time; answer only if it actually asked
    hit = run(["herdr", "pane", "wait-output", pane, "--match", "Do you trust",
               "--timeout", "5000"], check=False)
    if hit.returncode == 0:
        herdr("agent", "send-keys", handle, "enter")
        time.sleep(1)


class Plan:
    """Either do each step, or print it (--dry-run)."""

    def __init__(self, dry: bool) -> None:
        self.dry = dry

    def step(self, label: str, argv: list[str] | None = None) -> None:
        mark = "would" if self.dry else "→"
        print(f"{mark} {label}")
        if argv and self.dry:
            print(f"     {shlex.join(argv)}")


def source_agent_env(project: dict, pane: str, values: dict[str, str], plan: Plan) -> None:
    """Source a project environment in the pane before the agent process starts."""
    hook = project.get("hooks", {}).get("source_env")
    if not hook:
        # Returning quietly makes a missing key indistinguishable from a key that did
        # its job: the dry run lists what the project configured and never the gap.
        plan.step("skip agent environment (no hooks.source_env — the agent gets a bare shell)")
        return
    hook_path = resolve(hook)
    if not hook_path.exists():
        raise Fail(f"hooks.source_env points at {hook_path}, which does not exist")

    marker = f"__FOREMAN_ENV_READY_{os.getpid()}_{time.time_ns()}__"
    # Keep the full marker out of the echoed command so wait-output cannot match too early.
    split = len(marker) // 2
    marker_expr = f"'{marker[:split]}'" + f"'{marker[split:]}'"
    exports = "; ".join(
        f"export {name}={shlex.quote(str(value))}" for name, value in values.items()
    )
    command = (f"{exports}; source {shlex.quote(str(hook_path))} && "
               f"printf '%s\\n' {marker_expr}")
    argv = ["herdr", "pane", "run", pane, command]
    plan.step(f"source agent environment ({hook_path.name})", argv)
    if plan.dry:
        return

    herdr("pane", "run", pane, command)
    ready = run(["herdr", "pane", "wait-output", pane, "--source", "recent-unwrapped",
                 "--match", marker, "--timeout", "60000"], check=False)
    if ready.returncode != 0:
        detail = ready.stderr.strip() or ready.stdout.strip()
        raise Fail(f"source_env did not complete in pane {pane}: {detail}")


def cmd_assign(args: argparse.Namespace) -> None:
    settings = load_settings()
    project = load_project(args.project, settings)
    mode = args.mode          # from the subcommand, so argparse already vouches for it

    task = derive_task(args)
    # herdr rejects an agent name over 32 characters, and it does so at `agent start` —
    # by which point the worktree exists, its venv is installed and the panes are split.
    # The task name is what every handle is built from, so check it before any of that.
    for role in MODE_ROLES[mode]:
        handle = task + ROLE_SUFFIX.get(role, "")
        if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", handle):
            raise Fail(f"handle {handle!r} ({len(handle)} chars) is not a name herdr accepts: "
                       f"lowercase, digits, '-' or '_', 32 max.\n"
                       f"        Pass a shorter --task (up to "
                       f"{32 - max(len(s) for s in (ROLE_SUFFIX.get(r, '') for r in MODE_ROLES[mode]))}"
                       f" characters for {mode}).")
    branch = args.branch or task
    main = Path(project["main"]).expanduser()
    wt = Path(args.dir).expanduser() if args.dir else (
        Path(project["worktree_root"]).expanduser() / f"{project.get('dir_prefix', '')}{task}")
    base = args.base or project.get("base", "main")
    plan_abs = str((main / args.plan).resolve()) if args.plan else ""
    if plan_abs and not Path(plan_abs).exists():
        raise Fail(f"no such plan: {plan_abs}")
    # the renderer has no conditionals, so the note that only holds for a plan rides along
    # with the plan; the ledger keeps the bare path
    plan_field = (plan_abs + "\n(Absolute; the plan directory may be gitignored. Golden "
                  "reference and evidence live beside it.)" if plan_abs else "")

    p = Plan(args.dry_run)
    print(f"task={task}  mode={mode}  branch={branch}  base={base}\nworktree={wt}")

    # 1. worktree
    if wt.exists():
        print(f"worktree already there, reusing: {wt}")
        p.step("open existing worktree", ["herdr", "worktree", "open", "--cwd", str(main),
                                     "--path", str(wt), "--label", task, "--json"])
        res = {} if p.dry else herdr("worktree", "open", "--cwd", str(main),
                                     "--path", str(wt), "--label", task, "--json")
    else:
        p.step("create worktree", ["herdr", "worktree", "create", "--cwd", str(main),
                               "--branch", branch, "--base", base, "--path", str(wt),
                               "--label", task, "--no-focus", "--json"])
        res = {} if p.dry else herdr("worktree", "create", "--cwd", str(main),
                                     "--branch", branch, "--base", base, "--path", str(wt),
                                     "--label", task, "--no-focus", "--json")
    ws = res.get("workspace", {}).get("workspace_id", "<ws>")
    root_pane = res.get("root_pane", {}).get("pane_id") or \
        (res.get("panes") or [{}])[0].get("pane_id", "<pane>")

    # 2. post_worktree hook — venv, symlinks, whatever the project needs
    hook = project.get("hooks", {}).get("post_worktree")
    if hook:
        hook_path = resolve(hook)
        if not hook_path.exists():
            raise Fail(f"hooks.post_worktree points at {hook_path}, which does not exist")
        p.step(f"set up worktree ({hook_path.name})", [str(hook_path)])
        if not p.dry:
            env = {"FOREMAN_WORKTREE": str(wt), "FOREMAN_MAIN": str(main),
                   "FOREMAN_TASK": task, "FOREMAN_BRANCH": branch,
                   "FOREMAN_MODE": mode}
            proc = subprocess.run([str(hook_path)], cwd=wt, text=True, env={**os.environ, **env})
            if proc.returncode != 0:
                raise Fail(f"post_worktree hook exited {proc.returncode} — nothing was dispatched")

    # 3. panes — a pair needs a second
    panes = {MODE_ROLES[mode][0]: root_pane}
    if mode == "pair":
        p.step("split a pane for review", ["herdr", "pane", "split", "--pane", root_pane,
                                          "--direction", "right", "--ratio", "0.5",
                                          "--cwd", str(wt), "--no-focus"])
        if p.dry:
            panes["review"] = "<pane2>"
        else:
            herdr("pane", "split", "--pane", root_pane, "--direction", "right",
                  "--ratio", "0.5", "--cwd", str(wt), "--no-focus")
            # split has no --json, so find the non-root pane in the workspace listing
            listed = [q["pane_id"] for q in herdr("pane", "list", "--workspace", ws)
                      .get("panes", []) if q["pane_id"] != root_pane]
            if not listed:
                raise Fail(f"split done but no new pane showed up in workspace {ws}")
            panes["review"] = listed[-1]

    # 4. agents, and their opening prompt
    agents = {}
    for role in MODE_ROLES[mode]:
        handle = task + ROLE_SUFFIX.get(role, "")
        agents[role] = {"handle": handle, "pane": panes[role],
                        **agent_spec(settings, mode, role, args)}
    for role, info in agents.items():
        peer_info = next((a for r, a in agents.items() if r != role), {})
        peer = peer_info.get("handle", "")
        tpl = template_path(project, role, mode)
        # both halves of a pair share one protocol, so it can't drift between templates
        shared = find_template(project, "pair-protocol").read_text() if mode == "pair" else ""
        text = render(tpl, {
            "task": task, "role": role, "self": info["handle"], "peer": peer,
            "worktree": str(wt), "branch": branch, "base": base, "main": str(main),
            "plan": plan_field, "brief": args.prompt or "", "mode": mode,
            "self_pane": info["pane"], "peer_pane": peer_info.get("pane", ""),
            # one key per role, so a project can say something different to each of the three
            **{f"{r}_notes": project.get(f"{r}_notes", "") for r in ("solo", "impl", "review")},
        }, protocol=shared)
        source_agent_env(project, info["pane"], {
            "FOREMAN_WORKTREE": str(wt), "FOREMAN_MAIN": str(main),
            "FOREMAN_TASK": task, "FOREMAN_BRANCH": branch,
            "FOREMAN_MODE": mode, "FOREMAN_ROLE": role,
        }, p)
        start_agent(info["handle"], info["pane"], info, settings, p)
        p.step(f"prompt {info['handle']} (template {tpl})")
        if p.dry:
            print("     ┌─ prompt " + "─" * 58)
            for line in text.splitlines():
                print("     │ " + line)
            print("     └" + "─" * 67)
        else:
            submit_prompt(info["handle"], text)

    if p.dry:
        print("\n(--dry-run: nothing was executed)")
        return

    write_job({"task": task, "project": project["name"], "mode": mode, "branch": branch,
               "base": base, "path": str(wt), "main": str(main),
               "plan": plan_abs, "brief": args.prompt or "",
               "workspace": ws, "agents": agents,
               "created": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
    print()
    for role, info in agents.items():
        print(f"{info['pane']:9} {role:7} {info['handle']}")
    first = next(iter(agents.values()))["pane"]
    print(f"\nmessage  foreman say {first} \"...\"        # always address by pane id "
          f"(space:pane); names cross wires\nwatch    herdr agent read {first}\n"
          f"take over  herdr agent attach {first}   # leave with C-c twice")


# ── status ────────────────────────────────────────────────────────────────────


def pr_summary(path: Path, branch: str) -> str:
    if not shutil.which("gh"):
        return "—"
    proc = run(["gh", "pr", "list", "--head", branch, "--state", "all", "--limit", "1",
                "--json", "number,state,mergeStateStatus"], cwd=path, check=False)
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return "—"
    if not rows:
        return "—"
    pr = rows[0]
    bits = [f"#{pr['number']}", pr["state"].lower()]
    checks = run(["gh", "pr", "checks", str(pr["number"]), "--json", "state"],
                 cwd=path, check=False)
    try:
        states = {c["state"] for c in json.loads(checks.stdout or "[]")}
    except json.JSONDecodeError:
        states = set()
    if states:
        bits.append("CI:fail" if states & {"FAILURE", "ERROR", "TIMED_OUT"}
                    else "CI:running" if states & {"PENDING", "IN_PROGRESS", "QUEUED"}
                    else "CI:green")
    if pr.get("mergeStateStatus") in ("BEHIND", "DIRTY", "BLOCKED"):
        bits.append(pr["mergeStateStatus"])
    return " ".join(bits)


def cmd_status(args: argparse.Namespace) -> None:
    jobs = ([read_job(split_handle(args.task)[0])] if args.task
            else [json.loads(p.read_text()) for p in sorted(JOBS.glob("*.json"))])
    if not jobs:
        print("no live jobs")
        return

    live = {}
    for a in herdr("agent", "list").get("agents", []):
        if a.get("name"):
            live[a["name"]] = a

    for job in jobs:
        path = Path(job["path"])
        dirty = len([l for l in git(path, "status", "--short").splitlines() if l.strip()]) \
            if path.exists() else "?"
        head = git(path, "log", "--oneline", "-1")[:56] if path.exists() else "worktree gone"
        pr = pr_summary(path, job["branch"]) if path.exists() else "—"
        print(f"\n{job['task']}  [{job['mode']}]  {job['branch']}  dirty={dirty}  PR={pr}")
        print(f"  {head}")
        statuses = []
        for role, info in job["agents"].items():
            handle = info["handle"]
            agent = live.get(handle)
            state = agent["agent_status"] if agent else "not running"
            statuses.append(state)
            spec = info["kind"] + (f"/{info['effort']}" if info.get("effort") else "")
            pair = " ⇄" if job["mode"] == "pair" else "  "
            print(f"  {info['pane']:9}{pair} {role:7} {state:9} {spec:16} {handle}")
        if job["mode"] == "pair" and set(statuses) <= {"idle", "done"} and pr == "—":
            print("  ⚠ both idle and no PR — a handoff may have been dropped; take a look")


# ── say ───────────────────────────────────────────────────────────────────────


def cmd_say(args: argparse.Namespace) -> None:
    """The channel between two agents. The rules are enforced here, not left to the prompt."""
    settings = load_settings()
    limit = int(settings.get("channel", {}).get("max_chars", 4000))
    wait_ms = int(settings.get("channel", {}).get("wait_idle_ms", 60000))

    me = whoami()
    words = list(args.words)
    pane = label = None
    if len(words) > 1:
        head = words[0]
        if re.fullmatch(r"w[A-Za-z0-9]+:p\d+", head):
            # the formal form, space:pane — the only one that survives several live pairs
            pane = label = head
            for path in JOBS.glob("*.json"):
                job = json.loads(path.read_text())
                for role, info in job["agents"].items():
                    if info["pane"] == head:
                        label = f"{head} = {job['task']}.{role}"
        elif split_handle(head)[0] in {p.stem for p in JOBS.glob("*.json")}:
            # the convenience form, <task>.impl — an exact ledger lookup, still ending in a pane id
            task, role = split_handle(head)
            job = read_job(task)
            to = pick_role(job, role)
            pane = job["agents"][to]["pane"]
            label = f"{pane} = {task}.{to}"
        if pane:
            words.pop(0)

    if not pane:
        if not me:
            raise Fail('no recipient given, and this pane belongs to no job.\n'
                       '        The formal address is a pane id (space:pane), from '
                       '`herdr agent list` or `foreman status`:\n'
                       '            foreman say <space>:<pane> "..."\n'
                       '        Jobs foreman dispatched also answer to <task>.impl / <task>.rev.\n'
                       '        Window titles are refused: agent frameworks rewrite them, and '
                       'they cross wires between pairs.')
        job, my_role = me
        peers = [r for r in job["agents"] if r != my_role]
        if not peers:
            raise Fail(f"job {job['task']} is solo — no partner; give a pane id explicitly")
        pane = job["agents"][peers[0]]["pane"]
        label = f"{pane} = {job['task']}.{peers[0]}"

    # the prefix names the speaker; no prefix means a human is talking
    prefix = f"[{me[0]['task']}.{me[1]}] " if me else ""

    # 1. collapse to one line: in a TUI a newline is enter, which submits half a message
    text = re.sub(r"\s+", " ", " ".join(words)).strip()
    if not text:
        raise Fail("empty message, not sending")

    # 2. one mechanical ceiling: on a single line, a long body is truncated by the input box
    #    or swallowed into a `[Pasted text #N]` chip (see submit_prompt). Not a style rule —
    #    review is read-only and cannot "write a file and point at it", so a stricter cap
    #    would corner a legitimate findings list.
    if limit and len(text) > limit:
        raise Fail(
            f"message is {len(text)} chars, over the {limit} limit — one line that long "
            f"won't fit a TUI input box.\n"
            f"        Send it as two, or give a diff range, a path, a command and let them "
            f"look themselves\n        (you share one tree). To lift it: "
            f"[channel] max_chars in local/foreman.toml, 0 for no limit.")

    body = text if text.startswith("[") else prefix + text

    # 3. wait for them to be free — mid-turn messages get eaten — but send anyway on timeout:
    #    a hanging command gets backgrounded by codex, losing the receipt. No --until, because
    #    the default covers done as well, and codex reports done rather than idle after a turn
    if not args.now:
        run(["herdr", "agent", "wait", pane, "--timeout", str(wait_ms)], check=False)
    submit_prompt(pane, body)
    print(f"→ {label}: {body}")


# ── restart / done ────────────────────────────────────────────────────────────


def cmd_restart(args: argparse.Namespace) -> None:
    task, role = split_handle(args.task)
    job = read_job(task)
    role = pick_role(job, role)
    info = job["agents"][role]
    settings = load_settings()
    project = load_project(job.get("project"), settings)

    herdr("agent", "send-keys", info["handle"], "esc")          # stop the current turn
    time.sleep(1)
    herdr("agent", "send-keys", info["handle"], "C-c", "C-c")   # quit the agent
    time.sleep(2)
    source_agent_env(project, info["pane"], {
        "FOREMAN_WORKTREE": job["path"], "FOREMAN_MAIN": job["main"],
        "FOREMAN_TASK": job["task"], "FOREMAN_BRANCH": job["branch"],
        "FOREMAN_MODE": job["mode"], "FOREMAN_ROLE": role,
    }, Plan(False))
    start_agent(info["handle"], info["pane"], info, settings, Plan(False))
    note = args.note or ("Carry on with the plan. What is already in the worktree is your own "
                         "earlier work; pick up from there."
                         if role != "review" else
                         "Carry on reviewing. The changes in the worktree are impl's; you read, "
                         "you don't write.")
    submit_prompt(info["handle"], note)
    print(f"restarted {info['handle']} ({info['kind']}"
          f"{'/' + info['effort'] if info.get('effort') else ''}, pane {info['pane']})")


def cmd_done(args: argparse.Namespace) -> None:
    """Tear a job down. Every step is best-effort on purpose.

    Cleanup runs against a world that has usually moved on: agents quit, panes get closed by
    hand, a workspace is gone. Treating any of that as an error is how a job becomes
    unremovable — the first dead agent aborts the command, and the worktree it was supposed
    to take with it stays behind with no ledger left to name it.
    """
    task, _ = split_handle(args.task)
    job = read_job(task)

    for role, info in job["agents"].items():
        alive = run(["herdr", "agent", "get", info["handle"]], check=False).returncode == 0
        if alive:
            run(["herdr", "agent", "send-keys", info["handle"], "esc"], check=False)
            time.sleep(0.5)
            run(["herdr", "agent", "send-keys", info["handle"], "C-c", "C-c"], check=False)
        print(f"{'stopped' if alive else 'already gone'}: {role} {info['handle']}")
    time.sleep(1)

    path = Path(job["path"])
    main = job.get("main")
    if not main:
        # ledgers written before `main` was recorded: fall back to the project config
        try:
            main = str(Path(load_project(job.get("project"), load_settings())["main"]).expanduser())
        except Fail:
            main = None

    if args.rm:
        # removing the workspace takes its panes with it (remove wants --workspace, not a path)
        rm = run(["herdr", "worktree", "remove", "--workspace", job["workspace"], "--force"],
                 check=False)
        if rm.returncode != 0 and path.exists() and main:
            # the workspace was already gone; the git worktree is still ours to remove
            run(["git", "-C", main, "worktree", "remove", "--force", str(path)], check=False)
            run(["git", "-C", main, "worktree", "prune"], check=False)
        print(f"removed worktree {path}" if not path.exists() else
              f"could not remove worktree {path} — remove it by hand")
    else:
        for info in job["agents"].values():
            run(["herdr", "pane", "close", info["pane"]], check=False)
        print(f"worktree and changes kept: {path}")

    if args.rm and not path.exists():
        # a worktree removed without its branch leaves a name that blocks reusing the task.
        # -d refuses to drop unmerged work, which is the behaviour we want; say so and let
        # the human force it.
        if not main:
            print(f"kept branch {job['branch']} — could not locate the main worktree")
        else:
            drop = run(["git", "-C", main, "branch", "-d", job["branch"]], check=False)
            if drop.returncode == 0:
                print(f"deleted branch {job['branch']}")
            else:
                print(f"kept branch {job['branch']} — {(drop.stderr or '').strip().splitlines()[0]
                                                       if drop.stderr else 'git refused'}\n"
                      f"  git -C {main} branch -D {job['branch']}   # to drop it anyway")

    archive = JOBS.parent / "done"
    archive.mkdir(parents=True, exist_ok=True)
    job_path(task).rename(archive / f"{task}.json")
    print(f"ledger archived to {archive / (task + '.json')}")


# ── CLI ───────────────────────────────────────────────────────────────────────


def main() -> None:
    ap = argparse.ArgumentParser(prog="foreman", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"foreman {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    # mode is a subcommand, not a positional: solo never shows --review-*, and a bare
    # --kind stops meaning two different things depending on the mode
    asg = sub.add_parser("assign", help="hand out a plan, or a one-liner")
    modes = asg.add_subparsers(dest="mode", required=True)

    def add_common(sp, *, pair: bool) -> None:
        what = sp.add_mutually_exclusive_group(required=True)
        what.add_argument("--plan", help="plan file, relative to the project's main worktree")
        what.add_argument("--prompt", help="say the job in a sentence, if there is no plan")
        sp.add_argument("--task",
                        help="job name; from the plan filename, required with --prompt")
        sp.add_argument("--branch", help="branch name, defaults to the task name")
        sp.add_argument("--dir",
                        help="worktree path, default {worktree_root}/{dir_prefix}{task}")
        sp.add_argument("--base", help="ref to branch off, defaults to the project's base")
        sp.add_argument("--project")
        both = " (both agents)" if pair else ""
        sp.add_argument("--kind", help=f"agent kind: codex / claude / ...{both}")
        sp.add_argument("--model", help=f"model{both}")
        sp.add_argument("--effort", help=f"effort: low / medium / high / xhigh / max{both}")
        sp.add_argument("--tier", help=f"service tier, e.g. codex's fast / flex{both}")
        if pair:
            sp.add_argument("--review-kind",
                            help="review only — a second model has different blind spots")
            sp.add_argument("--review-model")
            sp.add_argument("--review-effort")
            sp.add_argument("--review-tier")
        sp.add_argument("--dry-run", action="store_true",
                        help="print every herdr command and the rendered prompts, run nothing")
        sp.set_defaults(fn=cmd_assign)

    add_common(modes.add_parser("solo", help="one agent, all the way to a PR"), pair=False)
    add_common(modes.add_parser("pair", help="impl writes, review gates read-only"), pair=True)

    sy = sub.add_parser("say", help="message your partner; the channel rules are enforced")
    sy.add_argument("words", nargs="+", metavar="[<to>] <text>",
                    help="recipient: <task>[.impl|.rev], a herdr agent name, or a pane id "
                         "like w2F:p1. Omit it inside a job's pane and your partner is used")
    sy.add_argument("--now", action="store_true", help="deliver at once, don't wait for them")
    sy.set_defaults(fn=cmd_say)

    st = sub.add_parser("status", help="who is paired with whom, doing what, PR how far along")
    st.add_argument("task", nargs="?")
    st.set_defaults(fn=cmd_status)

    rs = sub.add_parser("restart", help="restart one role in place, same model and permissions")
    rs.add_argument("task", help="<task>, or <task>.rev / <task>.impl")
    rs.add_argument("--note")
    rs.set_defaults(fn=cmd_restart)

    dn = sub.add_parser("done", help="wrap up: stop the agents, close the panes")
    dn.add_argument("task")
    dn.add_argument("--rm", action="store_true", help="remove the worktree too")
    dn.set_defaults(fn=cmd_done)

    # hook output goes straight to the terminal; don't let buffering reorder ours behind it
    sys.stdout.reconfigure(line_buffering=True)
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    try:
        main()
    except Fail as exc:
        print(exc, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
