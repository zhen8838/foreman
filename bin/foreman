#!/usr/bin/env python3
"""foreman — hand a plan, or a one-line job, to agents in their own worktree.

Two modes:
  solo  one agent takes it all the way to a PR.
  pair  two agents in one worktree: impl writes, review gates and stays read-only.

foreman does two things: start the agents, wire them to each other. It runs on herdr-core's
`hc`: one terminal per agent, labelled so herdr-app shows each job as a space of its own.
Watching a screen and taking one over are not wrapped (`hc read/attach` directly). Only
messaging is, as `foreman say` — channel rules have to be enforced by the program, not by good
intentions.

Usage: `foreman --help`. Config and templates: see the repo README.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

VERSION = "0.2.0"

REPO = Path(__file__).resolve().parent.parent
# Both can be pointed elsewhere, so an end-to-end test runs on config and ledgers of its own.
LOCAL = Path(os.environ.get("FOREMAN_LOCAL") or REPO / "local")
JOBS = Path(os.environ.get("FOREMAN_STATE") or REPO / "state") / "jobs"

ROLE_SUFFIX = {"impl": "-impl", "review": "-rev"}
MODE_ROLES = {"solo": ["solo"], "pair": ["impl", "review"]}

# How long an agent may take to report in, on top of whatever source_env is allowed.
BOOT_TIMEOUT_S = 60

# The shape of an hc terminal address: `t7`, `t1b`, or `machine/t7`. Words like "the" have it
# too, so a match is only a candidate until hc confirms the terminal (see resolve_recipient).
ADDRESS = re.compile(r"(?:[a-z0-9][a-z0-9_-]*/)?t[0-9a-z]{1,6}")


# ── helpers ───────────────────────────────────────────────────────────────────


class Fail(SystemExit):
    def __init__(self, msg: str) -> None:
        super().__init__(f"foreman: {msg}")


def run(argv: list[str], *, cwd: Path | None = None, check: bool = True,
        env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        argv, cwd=cwd, check=check, text=True, capture_output=True,
        env={**os.environ, **env} if env else None,
    )


def hc(cmd: str, *argv: str, check: bool = True) -> dict:
    """Run one hc command and return its JSON object.

    hc reports a failure as `{"error": {kind, message, hint}}` on stderr, with an exit code of
    its own (3 not_found, 9 blocked, 11 finished). check=False hands that back as
    `{"error": {...}, "exit": code}`, for the paths that must carry on regardless — teardown.
    """
    try:
        proc = run(["hc", cmd, "--json", *argv], check=False)
    except FileNotFoundError:
        raise Fail("hc is not on PATH — foreman runs every agent through herdr-core") from None
    if proc.returncode != 0:
        try:
            err = json.loads(proc.stderr).get("error") or {}
        except (json.JSONDecodeError, AttributeError):
            err = {}
        err.setdefault("message", (proc.stderr or proc.stdout).strip()
                       or f"exit {proc.returncode}")
        if check:
            hint = f"\n        {err['hint']}" if err.get("hint") else ""
            raise Fail(f"hc {cmd} {shlex.join(argv)[:200]} failed: {err['message']}{hint}")
        return {"error": err, "exit": proc.returncode}
    out = proc.stdout.strip()
    if not out:
        return {}
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {"_raw": out}


def run_argv(name: str, cwd: Path, labels: dict[str, str], argv: list[str]) -> list[str]:
    """The one `hc run` foreman issues; every agent terminal starts through here, so the flags
    that decide a terminal's lifetime are decided once.

    --no-parent  hc otherwise makes whoever ran foreman — usually a planner's terminal — the
                 parent. The agents would die when that session ends, and every turn they
                 finish would be typed into the planner's input as a note. A dispatched job
                 outlives the session that dispatched it.
    labels       herdr.space / herdr.tab are how herdr-app adopts a terminal it did not start
                 (herdr-app #290): an id it doesn't know becomes a new space or tab, and an
                 unlabelled terminal is never shown. Terminals that share a tab id split it
                 side by side, in the order the app adopts them; the labels are read once, so
                 relabelling an adopted terminal does not move it. foreman.task / foreman.role let a
                 terminal find its own job.
    """
    out = ["run", "--bg", "--no-parent", "--name", name, "--cwd", str(cwd)]
    for key, value in labels.items():
        out += ["--label", f"{key}={value}"]
    return [*out, "--", *argv]


def new_id(prefix: str) -> str:
    """A herdr-app space (`sp`) or tab (`tb`) id, in the shape the app makes its own."""
    return prefix + secrets.token_hex(16)


def git(path: Path, *argv: str) -> str:
    proc = run(["git", "-C", str(path), *argv], check=False)
    return proc.stdout.strip() if proc.returncode == 0 else ""


def load_toml(path: Path) -> dict:
    with path.open("rb") as fh:
        return tomllib.load(fh)


def resolve(rel: str) -> Path:
    """`local/x` wins over the repo's `x`; an absolute path is used as given."""
    p = Path(rel).expanduser()
    if p.is_absolute():
        return p
    override = LOCAL / rel
    return override if override.exists() else REPO / rel


# ── config ────────────────────────────────────────────────────────────────────


def load_settings() -> dict:
    path = LOCAL / "foreman.toml"
    if not path.exists():
        raise Fail(f"missing {path} — run ./install.sh once; it seeds one from examples/")
    return load_toml(path)


def project_files() -> list[Path]:
    return sorted(p for p in LOCAL.glob("*.toml") if p.name != "foreman.toml")


def load_project(name: str | None, settings: dict) -> dict:
    """Pick the project: explicit --project → cwd's git toplevel matching `main` → default."""
    candidates = {}
    for path in project_files():
        cfg = load_toml(path)
        # the one free-text block is per role now; a leftover rules/notes would say nothing
        # to anybody, silently, so refuse instead of dropping it
        if stale := [k for k in ("rules", "notes") if k in cfg]:
            raise Fail(f"{path}: {', '.join(stale)} no longer reaches any template — split it "
                       f"into solo_notes / impl_notes / review_notes, one per role")
        cfg.setdefault("name", path.stem)
        cfg["_path"] = str(path)
        candidates[cfg["name"]] = cfg
    if not candidates:
        raise Fail(f"no project config in {LOCAL} — write one after examples/project.toml")

    if name:
        if name not in candidates:
            raise Fail(f"no project {name} (known: {', '.join(sorted(candidates))})")
        return candidates[name]

    top = run(["git", "rev-parse", "--show-toplevel"], check=False).stdout.strip()
    if top:
        top = str(Path(top).resolve())
        for cfg in candidates.values():
            if str(Path(cfg["main"]).expanduser().resolve()) == top:
                return cfg

    default = settings.get("default_project")
    if default and default in candidates:
        return candidates[default]
    raise Fail("can't tell which project — pass --project, run inside the project's main "
               "worktree, or set default_project")


def agent_spec(settings: dict, mode: str, role: str, args: argparse.Namespace) -> dict:
    """Mode defaults plus command-line overrides → the agent this role runs on."""
    key = "agent" if mode == "solo" else role
    spec = dict(settings.get("modes", {}).get(mode, {}).get(key, {}))
    if not spec.get("kind"):
        raise Fail(f"local/foreman.toml: [modes.{mode}.{key}] has no kind")

    def override(field: str) -> str | None:
        # a targeted override like --review-kind beats the blanket --kind
        targeted = getattr(args, f"review_{field}", None) if role == "review" else None
        return targeted or getattr(args, field, None)

    default_kind = spec["kind"]
    for field in ("kind", "model", "effort", "tier"):
        if value := override(field):
            spec[field] = value
    if spec["kind"] != default_kind:
        # the defaults belong to the old kind (a codex model name means nothing to claude),
        # so keep only what was asked for explicitly and let the new agent read its own config
        for field in ("model", "effort", "tier"):
            if not override(field):
                spec.pop(field, None)
    return spec


def kind_table(settings: dict, kind: str) -> dict:
    table = settings.get("kinds", {}).get(kind)
    if table is None:
        raise Fail(f"local/foreman.toml has no [kinds.{kind}]")
    return table


def agent_argv(settings: dict, spec: dict) -> list[str]:
    """The agent's command line: its command, its fixed args, then model/effort/tier as flags
    via the kinds table. Unset means absent, which leaves the agent reading its own config."""
    kind = spec["kind"]
    table = kind_table(settings, kind)
    argv = [*table.get("command", [kind]), *table.get("args", [])]
    for field, flag_key in (("model", "model_flag"), ("effort", "effort_flag"),
                            ("tier", "tier_flag")):
        value = spec.get(field)
        if not value:
            continue
        for tok in table.get(flag_key, []):
            argv.append(tok.replace("{" + field + "}", str(value)))
    return argv


def submit_prompt(target: str, text: str) -> None:
    """Deliver one message, then say plainly whether it landed.

    `hc send` pastes the text, presses Enter, and reports `started`: whether the program went
    `working` within a few seconds of it. That is the transition check herdr made us build by
    hand, so all that is left here is reading the answer. A paste keeps its newlines inside one
    message; nothing submits half of it.

    An agent already working when the message arrives queues it, and its status never changes,
    so delivery neither proves nor disproves itself — say so rather than claim it landed. A
    blocked agent (a permission or a question on its screen) is refused by hc, and is not
    forced: a typed message could answer a dialog nobody has read.
    """
    res = hc("send", "--", target, text, check=False)
    if "error" in res:
        if res["exit"] == 9:
            raise Fail(f"{target} is blocked — a person is needed there (a permission or a "
                       f"question). Nothing was sent.\n        Go look: hc attach {target}")
        raise Fail(f"could not send to {target}: {res['error']['message']}")
    if res.get("started"):
        return
    if res.get("status") == "working":
        sys.stderr.write(
            f"foreman: {target} was already working, so delivery could not be confirmed — "
            f"the message is most likely queued.\n        Check with: hc read {target}\n")
    elif res.get("started") is None:
        sys.stderr.write(
            f"foreman: {target} reports no status, so delivery could not be confirmed.\n"
            f"        Check with: hc read {target}\n")
    else:
        sys.stderr.write(
            f"foreman: {target} never started a new turn — the text may be stuck in the "
            f"input box.\n        Go look: hc attach {target}\n")


# ── templates ─────────────────────────────────────────────────────────────────


def find_template(project: dict, name: str) -> Path:
    """Find a template, most specific first:

      local/templates/<project>/<name>.md   this project only
      local/templates/<name>.md             this machine
      templates/<name>.md                   shipped default

    An explicit path under [templates] in the project toml wins outright. Changing a prompt
    means dropping a file into one of those layers — no code involved.
    """
    explicit = project.get("templates", {}).get(name)
    if explicit:
        path = resolve(explicit)
        if not path.exists():
            raise Fail(f"[templates].{name} points at {path}, which does not exist")
        return path
    for cand in (
        LOCAL / "templates" / project["name"] / f"{name}.md",
        LOCAL / "templates" / f"{name}.md",
        REPO / "templates" / f"{name}.md",
    ):
        if cand.exists():
            return cand
    raise Fail(f"no template {name}.md anywhere")


def template_path(project: dict, role: str, mode: str) -> Path:
    name = "solo" if mode == "solo" else f"pair-{'impl' if role == 'impl' else 'review'}"
    return find_template(project, name)


def render(path: Path, fields: dict[str, str], protocol: str = "") -> str:
    """Fill a template. `{protocol}` goes in verbatim first, then every field.

    The order matters: impl and review share one protocol fragment, and that fragment carries
    placeholders of its own such as `{peer}`. Splicing it in first is what lets those get
    filled too.
    """
    text = path.read_text()
    if protocol:
        text = text.replace("{protocol}", protocol)
    for key, value in fields.items():
        # toml multi-line strings carry stray newlines; strip so templates gain no blanks
        text = text.replace("{" + key + "}", (value or "").strip())
    # drop a heading whose body the project left empty, rather than leave it dangling
    text = re.sub(r"^##[^\n]*\n\s*(?=^##|\Z)", "", text, flags=re.M)
    text = re.sub(r"\n{3,}", "\n\n", text)
    left = set(re.findall(r"\{([a-z_]+)\}", text)) - set(fields)
    if left:
        raise Fail(f"{path} has unknown placeholders: {', '.join(sorted(left))}")
    return text.strip()


# ── job ledger ────────────────────────────────────────────────────────────────


def job_path(task: str) -> Path:
    return JOBS / f"{task}.json"


def job_dir(task: str) -> Path:
    """Beside the ledger: each role's launch script and the prompts it was started with."""
    return JOBS / task


def read_job(task: str) -> dict:
    path = job_path(task)
    if not path.exists():
        known = sorted(p.stem for p in JOBS.glob("*.json"))
        raise Fail(f"no job {task} (known: {', '.join(known) or 'none'})")
    return json.loads(path.read_text())


def write_job(job: dict) -> None:
    JOBS.mkdir(parents=True, exist_ok=True)
    job_path(job["task"]).write_text(json.dumps(job, indent=2, ensure_ascii=False) + "\n")


def split_handle(ref: str) -> tuple[str, str | None]:
    """`t13.rev` / `t13-rev` / `t13` → (task, role|None)."""
    for sep in (".", "-"):
        head, _, tail = ref.rpartition(sep)
        if head and tail in ("impl", "rev", "review", "solo"):
            return head, {"rev": "review"}.get(tail, tail)
    return ref, None


def whoami() -> tuple[dict, str] | None:
    """Who am I: the terminal hc says this is, and the job its labels name. None when there is
    no match — a human's own terminal, for instance.

    `$HC_TERMINAL_ID` is safe to trust: an address belongs to one terminal forever on its core,
    and is never handed to another. The labels were set by `foreman assign` at `hc run`.
    """
    me = os.environ.get("HC_TERMINAL_ID")
    if not me:
        return None
    labels = hc("get", me, check=False).get("labels") or {}
    task, role = labels.get("foreman.task"), labels.get("foreman.role")
    if not task or not job_path(task).exists():
        return None
    job = read_job(task)
    return (job, role) if role in job["agents"] else None


def pick_role(job: dict, role: str | None) -> str:
    roles = list(job["agents"])
    if role is None:
        return "impl" if "impl" in roles else roles[0]
    if role not in roles:
        raise Fail(f"job {job['task']} has no role {role} (it has: {', '.join(roles)})")
    return role


def agent_env(job: dict, role: str) -> dict[str, str]:
    """What the source_env hook, and through it the agent, is told about the job."""
    return {
        "FOREMAN_WORKTREE": job["path"], "FOREMAN_MAIN": job["main"],
        "FOREMAN_TASK": job["task"], "FOREMAN_BRANCH": job["branch"],
        "FOREMAN_MODE": job["mode"], "FOREMAN_ROLE": role,
        "FOREMAN_PROMPT": job.get("brief", ""), "FOREMAN_PLAN": job.get("plan", ""),
    }


# ── agents ────────────────────────────────────────────────────────────────────


class Plan:
    """Either do each step, or print it (--dry-run)."""

    def __init__(self, dry: bool) -> None:
        self.dry = dry

    def step(self, label: str, argv: list[str] | None = None) -> None:
        mark = "would" if self.dry else "→"
        print(f"{mark} {label}")
        if argv and self.dry:
            print(f"     {shlex.join(argv)}")


def boxed(title: str, text: str) -> None:
    print(f"     ┌─ {title} " + "─" * max(0, 64 - len(title)))
    for line in text.splitlines():
        print("     │ " + line)
    print("     └" + "─" * 67)


# Turns the JSON array a source_env hook may leave behind into bash words, or refuses it.
_ARGS_TO_BASH = (
    "import json, shlex, sys\n"
    "args = json.load(open(sys.argv[1]))\n"
    "if not isinstance(args, list) or not all(isinstance(a, str) for a in args):\n"
    "    sys.exit('foreman: source_env agent arguments must be a JSON array of strings')\n"
    "print(shlex.join(args))\n"
)


def launch_script(argv: list[str], env: dict[str, str], hook: Path | None,
                  args_file: Path) -> str:
    """The script a role's terminal runs: export the job, source the project's hook, exec the
    agent with the prompt file named in `$1` as its last argument.

    One shell from start to finish, so whatever the hook exports or `cd`s into is what the
    agent inherits — the way a herdr pane's shell used to carry it. A failing hook ends the
    script with its own exit code, which is how foreman learns about it.

    A hook may also write a JSON array of strings to `$FOREMAN_AGENT_ARGS_FILE`: arguments
    that only exist after setup, such as a container's dynamic SSH endpoint. They go after the
    configured flags and before the prompt.
    """
    lines = ["#!/usr/bin/env bash",
             "# Written by foreman; `foreman restart` runs it again.",
             # a sourced file sees the caller's arguments; the hook gets none, as in a shell
             'prompt_file=$1; shift',
             *(f"export {key}={shlex.quote(str(value))}" for key, value in env.items()),
             "runtime_args=()"]
    if hook:
        lines += [
            f"export FOREMAN_AGENT_ARGS_FILE={shlex.quote(str(args_file))}",
            'rm -f -- "$FOREMAN_AGENT_ARGS_FILE"',
            f"source {shlex.quote(str(hook))} || {{ rc=$?; "
            f"echo \"foreman: source_env {hook.name} failed (exit $rc)\" >&2; exit $rc; }}",
            'if [ -e "$FOREMAN_AGENT_ARGS_FILE" ]; then',
            f"    words=$(python3 -I -c {shlex.quote(_ARGS_TO_BASH)} "
            '"$FOREMAN_AGENT_ARGS_FILE") || exit 98',
            '    eval "runtime_args=($words)"',
            '    rm -f -- "$FOREMAN_AGENT_ARGS_FILE"',
            "fi",
        ]
    lines.append(f'exec {shlex.join(argv)} "${{runtime_args[@]}}" "$(cat -- "$prompt_file")"')
    return "\n".join(lines) + "\n"


def wait_ready(addr: str, handle: str, table: dict, timeout_s: float) -> None:
    """Wait for the agent's first status report: from then on it is up and has its prompt.

    That first report is the startup `idle` (herdr-core #94); the opening prompt is already on
    the command line, so nothing is left to deliver. Two things come before it that hc has no
    event for: the source_env hook still running, and a folder trust dialog — agents draw it
    without reporting `blocked`, so it can only be seen on screen. Hence a poll, and not
    `hc wait`, which would sit through the whole first turn.
    """
    prompts = table.get("trust_prompt") or []
    prompts = [prompts] if isinstance(prompts, str) else list(prompts)
    keys = table.get("trust_keys") or ["enter"]
    deadline = time.monotonic() + timeout_s
    answered = False

    def last_output() -> str:
        text = hc("read", "--lines", "40", "--", addr, check=False).get("text", "").strip()
        return f"\n\nLast output:\n{text}" if text else ""

    while True:
        term = hc("get", "--", addr)
        if term.get("state") != "live":
            tail = last_output()
            hc("rm", "--", addr, check=False)
            raise Fail(f"{handle} ({addr}) exited {term.get('exit_code')} before the agent "
                       f"reported in — source_env or the agent's own startup failed{tail}")
        if term.get("reported"):
            return
        if prompts and not answered:
            screen = hc("read", "--", addr, check=False).get("text", "")
            if any(p in screen for p in prompts):
                # the folder is a worktree foreman just made from the project's own checkout
                hc("keys", "--", addr, *keys)
                answered = True
        if time.monotonic() >= deadline:
            raise Fail(f"{handle} ({addr}) did not report in within {timeout_s:g}s; it is "
                       f"still running.\n        Go look: hc attach {handle}{last_output()}")
        time.sleep(1)


def launch_agent(role: str, info: dict, *, job: dict, settings: dict, project: dict,
                 prompt: str, prompt_name: str, plan: Plan) -> str:
    """Start one agent in a terminal of its own and return the terminal's address.

    The prompt rides on the agent's command line, so there is never a booting agent to type
    into; see `launch_script` for the rest.
    """
    hook = None
    timeout_s = BOOT_TIMEOUT_S
    if rel := project.get("hooks", {}).get("source_env"):
        hook = resolve(rel)
        if not hook.exists():
            raise Fail(f"hooks.source_env points at {hook}, which does not exist")
        timeout_ms = project.get("hooks", {}).get("source_env_timeout_ms", 60000)
        if isinstance(timeout_ms, bool) or not isinstance(timeout_ms, int) or timeout_ms <= 0:
            raise Fail("hooks.source_env_timeout_ms must be a positive integer")
        timeout_s += timeout_ms / 1000
    else:
        # Saying nothing makes a missing key indistinguishable from a key that did its job:
        # the dry run lists what the project configured and never the gap.
        plan.step("skip agent environment (no hooks.source_env — the agent gets a bare shell)")

    workdir = job_dir(job["task"])
    script = workdir / f"{role}.launch.sh"
    prompt_file = workdir / f"{role}.{prompt_name}.md"
    text = launch_script(agent_argv(settings, info), agent_env(job, role), hook,
                         workdir / f"{role}.args.json")
    # a ledger from before a pair shared its tab still holds one tab id per role
    labels = {"herdr.space": job["space"], "herdr.tab": job.get("tab") or info["tab"],
              "foreman.task": job["task"], "foreman.role": role}
    argv = run_argv(info["handle"], Path(job["path"]), labels,
                    ["bash", str(script), str(prompt_file)])

    plan.step(f"write {script}" + (f", sourcing {hook.name}" if hook else ""))
    if plan.dry:
        boxed(script.name, text)
    plan.step(f"start {info['handle']} ({info['kind']}"
              f"{'/' + info['effort'] if info.get('effort') else ''})", ["hc", *argv])
    if plan.dry:
        return "<address>"

    workdir.mkdir(parents=True, exist_ok=True)
    prompt_file.write_text(prompt + "\n")
    script.write_text(text)
    addr = hc(*argv)["address"]
    wait_ready(addr, info["handle"], kind_table(settings, info["kind"]), timeout_s)
    return addr


def stop_terminal(addr: str) -> bool:
    """Stop an agent the way a person would, then make sure. Returns whether it was running.

    esc ends the turn and ctrl+c twice quits Claude and Codex, which lets them write their
    session out — a pre_done hook may archive it. kill (hangup, then escalate) is the fallback.
    """
    if hc("get", "--", addr, check=False).get("state") != "live":
        return False
    hc("interrupt", "--timeout", "3", "--", addr, check=False)
    hc("keys", "--", addr, "ctrl+c", "ctrl+c", check=False)
    for _ in range(10):
        time.sleep(0.5)
        if hc("get", "--", addr, check=False).get("state") != "live":
            return True
    hc("kill", "--", addr, check=False)
    return True


# ── assign ────────────────────────────────────────────────────────────────────


def derive_task(args: argparse.Namespace) -> str:
    if args.task:
        return args.task
    if args.plan:
        stem = Path(args.plan).stem
        return re.sub(r"^\d+[-_]", "", stem)  # drop the plan's ordering prefix
    raise Fail("--prompt needs --task: there is no plan filename to derive it from")


def cmd_assign(args: argparse.Namespace) -> None:
    settings = load_settings()
    project = load_project(args.project, settings)
    mode = args.mode          # from the subcommand, so argparse already vouches for it

    task = derive_task(args)
    # hc rejects a terminal name over 32 characters, and it does so at `hc run` — by which
    # point the worktree exists and its venv is installed. The task name is what every handle
    # is built from, so check it before any of that.
    for role in MODE_ROLES[mode]:
        handle = task + ROLE_SUFFIX.get(role, "")
        if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", handle):
            raise Fail(f"handle {handle!r} ({len(handle)} chars) is not a name hc accepts: "
                       f"lowercase, digits, '-' or '_', 32 max.\n"
                       f"        Pass a shorter --task (up to "
                       f"{32 - max(len(s) for s in (ROLE_SUFFIX.get(r, '') for r in MODE_ROLES[mode]))}"
                       f" characters for {mode}).")
    branch = args.branch or task
    main = Path(project["main"]).expanduser()
    wt = Path(args.dir).expanduser() if args.dir else (
        Path(project["worktree_root"]).expanduser() / f"{project.get('dir_prefix', '')}{task}")
    base = args.base or project.get("base", "main")
    plan_abs = str((main / args.plan).resolve()) if args.plan else ""
    if plan_abs and not Path(plan_abs).exists():
        raise Fail(f"no such plan: {plan_abs}")
    # the renderer has no conditionals, so the note that only holds for a plan rides along
    # with the plan; the ledger keeps the bare path
    plan_field = (plan_abs + "\n(Absolute; the plan directory may be gitignored. Golden "
                  "reference and evidence live beside it.)" if plan_abs else "")

    p = Plan(args.dry_run)
    print(f"task={task}  mode={mode}  branch={branch}  base={base}\nworktree={wt}")

    # 1. worktree — hc has none of its own, so it is git's job
    if wt.exists():
        print(f"worktree already there, reusing: {wt}")
    else:
        has_branch = run(["git", "-C", str(main), "rev-parse", "--verify", "--quiet",
                          f"refs/heads/{branch}"], check=False).returncode == 0
        add = ["git", "-C", str(main), "worktree", "add",
               *([str(wt), branch] if has_branch else ["-b", branch, str(wt), base])]
        p.step(f"create worktree on {'existing' if has_branch else 'new'} branch {branch}", add)
        if not p.dry:
            proc = run(add, check=False)
            if proc.returncode != 0:
                raise Fail(f"git worktree add failed: {proc.stderr.strip() or proc.stdout.strip()}")

    # 2. post_worktree hook — venv, symlinks, whatever the project needs
    hook = project.get("hooks", {}).get("post_worktree")
    if hook:
        hook_path = resolve(hook)
        if not hook_path.exists():
            raise Fail(f"hooks.post_worktree points at {hook_path}, which does not exist")
        p.step(f"set up worktree ({hook_path.name})", [str(hook_path)])
        if not p.dry:
            env = {"FOREMAN_WORKTREE": str(wt), "FOREMAN_MAIN": str(main),
                   "FOREMAN_TASK": task, "FOREMAN_BRANCH": branch,
                   "FOREMAN_MODE": mode, "FOREMAN_PROMPT": args.prompt or "",
                   "FOREMAN_PLAN": plan_abs}
            proc = subprocess.run([str(hook_path)], cwd=wt, text=True, env={**os.environ, **env})
            if proc.returncode != 0:
                raise Fail(f"post_worktree hook exited {proc.returncode} — nothing was dispatched")

    # 3. the ledger: one herdr-app space and one tab for the job — a pair splits that tab, impl
    #    left and review right, because impl starts first. Written before any
    #    agent starts, so a dispatch that fails halfway still leaves `foreman done` a record
    #    of what to stop.
    agents = {}
    for role in MODE_ROLES[mode]:
        agents[role] = {"handle": task + ROLE_SUFFIX.get(role, ""), "address": None,
                        **agent_spec(settings, mode, role, args)}
    job = {"task": task, "project": project["name"], "mode": mode, "branch": branch,
           "base": base, "path": str(wt), "main": str(main),
           "plan": plan_abs, "brief": args.prompt or "",
           "space": new_id("sp"), "tab": new_id("tb"), "agents": agents,
           "created": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    if not p.dry:
        write_job(job)

    # 4. agents, each with its opening prompt on its command line
    for role, info in agents.items():
        peer = next((a for r, a in agents.items() if r != role), {}).get("handle", "")
        tpl = template_path(project, role, mode)
        # both halves of a pair share one protocol, so it can't drift between templates
        shared = find_template(project, "pair-protocol").read_text() if mode == "pair" else ""
        text = render(tpl, {
            "task": task, "role": role, "self": info["handle"], "peer": peer,
            "worktree": str(wt), "branch": branch, "base": base, "main": str(main),
            "plan": plan_field, "brief": args.prompt or "", "mode": mode,
            # one key per role, so a project can say something different to each of the three
            **{f"{r}_notes": project.get(f"{r}_notes", "") for r in ("solo", "impl", "review")},
        }, protocol=shared)
        p.step(f"prompt {info['handle']} (template {tpl}), on its command line")
        if p.dry:
            boxed("prompt", text)
        try:
            info["address"] = launch_agent(role, info, job=job, settings=settings,
                                           project=project, prompt=text,
                                           prompt_name="prompt", plan=p)
        except Fail as exc:
            if p.dry:
                raise
            raise Fail(f"{str(exc.code).removeprefix('foreman: ')}\n        The ledger is "
                       f"written: `foreman done {task}` stops whatever did start.") from None
        if not p.dry:
            write_job(job)

    if p.dry:
        print("\n(--dry-run: nothing was executed)")
        return

    print()
    for role, info in agents.items():
        print(f"{info['address']:6} {role:7} {info['handle']}")
    first = next(iter(agents.values()))["handle"]
    print(f"\nherdr-app  a space of its own, one tab"
          f"{' split impl | review' if mode == 'pair' else ''}\n"
          f"message    foreman say {first} \"...\"\n"
          f"watch      hc read {first}\n"
          f"take over  hc attach {first}   # leave with Ctrl+\\")


# ── status ────────────────────────────────────────────────────────────────────


def pr_summary(path: Path, branch: str) -> str:
    if not shutil.which("gh"):
        return "—"
    proc = run(["gh", "pr", "list", "--head", branch, "--state", "all", "--limit", "1",
                "--json", "number,state,mergeStateStatus"], cwd=path, check=False)
    try:
        rows = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return "—"
    if not rows:
        return "—"
    pr = rows[0]
    bits = [f"#{pr['number']}", pr["state"].lower()]
    checks = run(["gh", "pr", "checks", str(pr["number"]), "--json", "state"],
                 cwd=path, check=False)
    try:
        states = {c["state"] for c in json.loads(checks.stdout or "[]")}
    except json.JSONDecodeError:
        states = set()
    if states:
        bits.append("CI:fail" if states & {"FAILURE", "ERROR", "TIMED_OUT"}
                    else "CI:running" if states & {"PENDING", "IN_PROGRESS", "QUEUED"}
                    else "CI:green")
    if pr.get("mergeStateStatus") in ("BEHIND", "DIRTY", "BLOCKED"):
        bits.append(pr["mergeStateStatus"])
    return " ".join(bits)


def cmd_status(args: argparse.Namespace) -> None:
    jobs = ([read_job(split_handle(args.task)[0])] if args.task
            else [json.loads(p.read_text()) for p in sorted(JOBS.glob("*.json"))])
    if not jobs:
        print("no live jobs")
        return

    # One listing, matched by address: an address is one terminal forever on this core,
    # where a name passes to the next terminal once a restart frees it.
    terms = {t["address"]: t for t in hc("ls", "--all").get("terminals", [])}

    for job in jobs:
        path = Path(job["path"])
        dirty = len([l for l in git(path, "status", "--short").splitlines() if l.strip()]) \
            if path.exists() else "?"
        head = git(path, "log", "--oneline", "-1")[:56] if path.exists() else "worktree gone"
        pr = pr_summary(path, job["branch"]) if path.exists() else "—"
        print(f"\n{job['task']}  [{job['mode']}]  {job['branch']}  dirty={dirty}  PR={pr}")
        print(f"  {head}")
        statuses = []
        for role, info in job["agents"].items():
            addr = info.get("address") or "—"
            term = terms.get(addr)
            if not term:
                state = "gone"
            elif term.get("state") != "live":
                state = "exited"
            else:
                state = term.get("status") or "starting"
            statuses.append(state)
            spec = info["kind"] + (f"/{info['effort']}" if info.get("effort") else "")
            # The program in the terminal may not be the one dispatched: an agent that crashed
            # leaves the shell herdr-app's keep puts in its place. Say so: `restart` would
            # replace whatever runs there.
            running = term.get("agent") if term and state not in ("exited", "starting") else None
            note = f"  ⚠ terminal runs {running}" if running and \
                not running.startswith(info["kind"]) else ""
            where = f"  [{term['where']}]" if term and term.get("where") else ""
            pair = " ⇄" if job["mode"] == "pair" else "  "
            print(f"  {addr:6}{pair} {role:7} {state:9} {spec:16} {info['handle']}{where}{note}")
        if job["mode"] == "pair" and set(statuses) <= {"idle", "done"} and pr == "—":
            print("  ⚠ both idle and no PR — a handoff may have been dropped; take a look")


# ── say ───────────────────────────────────────────────────────────────────────


def resolve_recipient(words: list[str], me: tuple[dict, str] | None) -> tuple[str, str, list[str]]:
    """Split `[<to>] <text>` into (target, label, text words).

    The first word is a recipient only if it is unmistakably one — the address of a terminal hc
    knows, or a job in the ledger — and something follows it. Otherwise the whole line is the
    message, and it goes to the partner of whoever is speaking.
    """
    if len(words) > 1:
        head = words[0]
        # hc get also answers to names; an address must come back as itself
        if ADDRESS.fullmatch(head) and \
                hc("get", "--", head, check=False).get("address") == head:
            label = head
            for path in JOBS.glob("*.json"):
                job = json.loads(path.read_text())
                for role, info in job["agents"].items():
                    if info.get("address") == head:
                        label = f"{head} = {job['task']}.{role}"
            return head, label, words[1:]
        task, role = split_handle(head)
        if job_path(task).exists():
            job = read_job(task)
            to = pick_role(job, role)
            handle = job["agents"][to]["handle"]
            return handle, f"{handle} = {task}.{to}", words[1:]

    if not me:
        raise Fail('no recipient given, and this terminal belongs to no job.\n'
                   '        Address an agent by name, from `foreman status`:\n'
                   '            foreman say <task>.impl "..."     (or <task>.rev, <task>)\n'
                   '        or by its hc address, such as t1b.')
    job, my_role = me
    peers = [r for r in job["agents"] if r != my_role]
    if not peers:
        raise Fail(f"job {job['task']} is solo — no partner; name a recipient explicitly")
    handle = job["agents"][peers[0]]["handle"]
    return handle, f"{handle} = {job['task']}.{peers[0]}", words


def cmd_say(args: argparse.Namespace) -> None:
    """The channel between two agents. The rules are enforced here, not left to the prompt.

    hc names the speaker itself — a message arrives as `<hc from="t1b x-impl">…</hc>` — so no
    prefix is added; a message from a terminal outside every job is a human talking.
    """
    settings = load_settings()
    limit = int(settings.get("channel", {}).get("max_chars", 4000))
    wait_ms = int(settings.get("channel", {}).get("wait_idle_ms", 60000))

    target, label, words = resolve_recipient(list(args.words), whoami())
    text = " ".join(words).strip()
    if not text:
        raise Fail("empty message, not sending")

    # One mechanical ceiling: a body that long is better given as a path or a diff range the
    # recipient can look at (you share one tree). Not a style rule — review is read-only and
    # cannot "write a file and point at it", so a stricter cap would corner a findings list.
    if limit and len(text) > limit:
        raise Fail(
            f"message is {len(text)} chars, over the {limit} limit.\n"
            f"        Send it as two, or give a diff range, a path, a command and let them "
            f"look themselves\n        (you share one tree). To lift it: "
            f"[channel] max_chars in local/foreman.toml, 0 for no limit.")

    # Wait for them to be free — a message into a running turn can get swallowed — but send
    # anyway on timeout: a command that hangs gets backgrounded by codex, losing the receipt.
    # A message to the speaker also ends the wait; it is read after this one goes out.
    if not args.now:
        hc("wait", "--timeout", str(max(1, wait_ms // 1000)), "--", target, check=False)
    submit_prompt(target, text)
    print(f"→ {label}: {text}")


# ── restart / done ────────────────────────────────────────────────────────────


def cmd_restart(args: argparse.Namespace) -> None:
    task, role = split_handle(args.task)
    job = read_job(task)
    role = pick_role(job, role)
    info = job["agents"][role]
    settings = load_settings()
    project = load_project(job.get("project"), settings)

    # A terminal runs one agent and ends with it, so a restart is a new terminal: same name,
    # same tab, a new address. The old one has to be gone first — names are unique among
    # live terminals.
    if info.get("address"):
        stop_terminal(info["address"])
        hc("rm", "--", info["address"], check=False)
    info["address"] = None
    write_job(job)

    note = args.note or ("Carry on with the plan. What is already in the worktree is your own "
                         "earlier work; pick up from there."
                         if role != "review" else
                         "Carry on reviewing. The changes in the worktree are impl's; you read, "
                         "you don't write.")
    info["address"] = launch_agent(role, info, job=job, settings=settings, project=project,
                                   prompt=note, prompt_name="restart", plan=Plan(False))
    write_job(job)
    print(f"restarted {info['handle']} ({info['kind']}"
          f"{'/' + info['effort'] if info.get('effort') else ''}, terminal {info['address']})")


def run_pre_done_hook(project: dict, job: dict, remove_worktree: bool) -> None:
    """Let a project preserve artifacts and release its own resources before teardown."""
    hook = project.get("hooks", {}).get("pre_done")
    if not hook:
        return
    hook_path = resolve(hook)
    if not hook_path.exists():
        raise Fail(f"hooks.pre_done points at {hook_path}, which does not exist")

    worktree = Path(job["path"])
    main = Path(job["main"]) if job.get("main") else worktree
    cwd = worktree if worktree.is_dir() else main
    env = {
        "FOREMAN_WORKTREE": str(worktree),
        "FOREMAN_MAIN": str(main),
        "FOREMAN_TASK": job["task"],
        "FOREMAN_BRANCH": job["branch"],
        "FOREMAN_MODE": job["mode"],
        "FOREMAN_PROMPT": job.get("brief", ""),
        "FOREMAN_PLAN": job.get("plan", ""),
        "FOREMAN_REMOVE_WORKTREE": "1" if remove_worktree else "0",
        "FOREMAN_AGENTS_JSON": json.dumps(job["agents"], separators=(",", ":")),
    }
    proc = subprocess.run([str(hook_path)], cwd=cwd, text=True, check=False,
                          env={**os.environ, **env})
    if proc.returncode != 0:
        raise Fail(f"pre_done hook {hook_path.name} exited {proc.returncode} — "
                   "terminals, worktree and ledger were kept")


def cmd_done(args: argparse.Namespace) -> None:
    """Tear a job down. Every step is best-effort on purpose.

    Cleanup runs against a world that has usually moved on: agents quit, terminals get killed
    by hand, a worktree is gone. Treating any of that as an error is how a job becomes
    unremovable — the first dead agent aborts the command, and the worktree it was supposed
    to take with it stays behind with no ledger left to name it.
    """
    task, _ = split_handle(args.task)
    job = read_job(task)
    project = load_project(job.get("project"), load_settings())

    for role, info in job["agents"].items():
        alive = bool(info.get("address")) and stop_terminal(info["address"])
        print(f"{'stopped' if alive else 'already gone'}: {role} {info['handle']}")

    # Sessions have now flushed, while the terminals (finished, still readable), worktree and
    # ledger all exist. A project can archive transcripts or release containers here; failure
    # must stop before data is lost.
    run_pre_done_hook(project, job, args.rm)

    # Removing a terminal closes its pane in herdr-app, and the job's space with the last one.
    for info in job["agents"].values():
        if info.get("address"):
            hc("rm", "--", info["address"], check=False)

    path = Path(job["path"])
    main = job.get("main")
    if not main:
        # ledgers written before `main` was recorded: fall back to the project config
        main = str(Path(project["main"]).expanduser())

    if args.rm:
        if path.exists():
            run(["git", "-C", main, "worktree", "remove", "--force", str(path)], check=False)
            run(["git", "-C", main, "worktree", "prune"], check=False)
        print(f"removed worktree {path}" if not path.exists() else
              f"could not remove worktree {path} — remove it by hand")
    else:
        print(f"worktree and changes kept: {path}")

    if args.rm and not path.exists():
        # a worktree removed without its branch leaves a name that blocks reusing the task.
        # -d refuses to drop unmerged work, which is the behaviour we want; say so and let
        # the human force it.
        drop = run(["git", "-C", main, "branch", "-d", job["branch"]], check=False)
        if drop.returncode == 0:
            print(f"deleted branch {job['branch']}")
        else:
            print(f"kept branch {job['branch']} — {(drop.stderr or '').strip().splitlines()[0]
                                                   if drop.stderr else 'git refused'}\n"
                  f"  git -C {main} branch -D {job['branch']}   # to drop it anyway")

    archive = JOBS.parent / "done"
    archive.mkdir(parents=True, exist_ok=True)
    job_path(task).rename(archive / f"{task}.json")
    if job_dir(task).is_dir():
        if (archive / task).exists():
            shutil.rmtree(archive / task)
        job_dir(task).rename(archive / task)
    print(f"ledger archived to {archive / (task + '.json')}")


# ── CLI ───────────────────────────────────────────────────────────────────────


def main() -> None:
    ap = argparse.ArgumentParser(prog="foreman", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"foreman {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    # mode is a subcommand, not a positional: solo never shows --review-*, and a bare
    # --kind stops meaning two different things depending on the mode
    asg = sub.add_parser("assign", help="hand out a plan, or a one-liner")
    modes = asg.add_subparsers(dest="mode", required=True)

    def add_common(sp, *, pair: bool) -> None:
        what = sp.add_mutually_exclusive_group(required=True)
        what.add_argument("--plan", help="plan file, relative to the project's main worktree")
        what.add_argument("--prompt", help="say the job in a sentence, if there is no plan")
        sp.add_argument("--task",
                        help="job name; from the plan filename, required with --prompt")
        sp.add_argument("--branch", help="branch name, defaults to the task name")
        sp.add_argument("--dir",
                        help="worktree path, default {worktree_root}/{dir_prefix}{task}")
        sp.add_argument("--base", help="ref to branch off, defaults to the project's base")
        sp.add_argument("--project")
        both = " (both agents)" if pair else ""
        sp.add_argument("--kind", help=f"agent kind: codex / claude / ...{both}")
        sp.add_argument("--model", help=f"model{both}")
        sp.add_argument("--effort", help=f"effort: low / medium / high / xhigh / max{both}")
        sp.add_argument("--tier", help=f"service tier, e.g. codex's fast / flex{both}")
        if pair:
            sp.add_argument("--review-kind",
                            help="review only — a second model has different blind spots")
            sp.add_argument("--review-model")
            sp.add_argument("--review-effort")
            sp.add_argument("--review-tier")
        sp.add_argument("--dry-run", action="store_true",
                        help="print every hc command and the rendered prompts, run nothing")
        sp.set_defaults(fn=cmd_assign)

    add_common(modes.add_parser("solo", help="one agent, all the way to a PR"), pair=False)
    add_common(modes.add_parser("pair", help="impl writes, review gates read-only"), pair=True)

    sy = sub.add_parser("say", help="message your partner; the channel rules are enforced")
    sy.add_argument("words", nargs="+", metavar="[<to>] <text>",
                    help="recipient: <task>[.impl|.rev], or an hc address like t1b. Omit it "
                         "inside a job's terminal and your partner is used")
    sy.add_argument("--now", action="store_true", help="deliver at once, don't wait for them")
    sy.set_defaults(fn=cmd_say)

    st = sub.add_parser("status", help="who is paired with whom, doing what, PR how far along")
    st.add_argument("task", nargs="?")
    st.set_defaults(fn=cmd_status)

    rs = sub.add_parser("restart", help="restart one role in place, same model and permissions")
    rs.add_argument("task", help="<task>, or <task>.rev / <task>.impl")
    rs.add_argument("--note")
    rs.set_defaults(fn=cmd_restart)

    dn = sub.add_parser("done", help="wrap up: stop the agents, close their terminals")
    dn.add_argument("task")
    dn.add_argument("--rm", action="store_true", help="remove the worktree too")
    dn.set_defaults(fn=cmd_done)

    # hook output goes straight to the terminal; don't let buffering reorder ours behind it
    sys.stdout.reconfigure(line_buffering=True)
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    try:
        main()
    except Fail as exc:
        print(exc, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
